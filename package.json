{
  "name": "snare-drummer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "yarn workspace @snare-drummer/web dev",
    "build": "yarn workspace @snare-drummer/web build",
    "preview": "yarn workspace @snare-drummer/web preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "yarn workspaces foreach --all --parallel --verbose --exclude snare-drummer run typecheck"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3"
  }
}
